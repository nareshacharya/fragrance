# Environment Configuration Example
# Copy this file to .env.local and fill in your actual values

# =============================================================================
# APPLICATION CONFIGURATION
# =============================================================================
NODE_ENV=development
NEXT_PUBLIC_APP_NAME=Fragrance Management System
NEXT_PUBLIC_APP_VERSION=0.1.0
NEXT_PUBLIC_APP_ENV=development

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================
# PostgreSQL connection string
DATABASE_URL=postgresql://username:password@localhost:5432/fragrance_db

# =============================================================================
# REDIS CONFIGURATION
# =============================================================================
# Redis connection string for caching and sessions
REDIS_URL=redis://localhost:6379

# =============================================================================
# AUTHENTICATION CONFIGURATION
# =============================================================================
# NextAuth.js secret (generate with: openssl rand -base64 32)
NEXTAUTH_SECRET=your-nextauth-secret-key-here-minimum-32-characters
NEXTAUTH_URL=http://localhost:3000

# JWT configuration
JWT_SECRET=your-jwt-secret-key-here-minimum-32-characters
JWT_EXPIRES_IN=7d

# =============================================================================
# API CONFIGURATION
# =============================================================================
# Base URL for internal API
API_BASE_URL=http://localhost:3000/api
EXTERNAL_API_TIMEOUT=30000

# =============================================================================
# PEGA DX INTEGRATION
# =============================================================================
# Pega DX API configuration
PEGA_DX_API_URL=https://your-pega-instance.com/api
PEGA_DX_API_KEY=your-pega-api-key
PEGA_DX_CLIENT_ID=your-pega-client-id
PEGA_DX_CLIENT_SECRET=your-pega-client-secret

# =============================================================================
# EMAIL CONFIGURATION
# =============================================================================
# SMTP settings for email notifications
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM=noreply@yourdomain.com

# =============================================================================
# FILE UPLOAD CONFIGURATION
# =============================================================================
# File upload limits (in bytes)
UPLOAD_MAX_SIZE=10485760
UPLOAD_ALLOWED_TYPES=image/jpeg,image/png,image/gif,application/pdf,text/csv

# =============================================================================
# LOGGING CONFIGURATION
# =============================================================================
LOG_LEVEL=info
LOG_FORMAT=json

# =============================================================================
# FEATURE FLAGS
# =============================================================================
# Enable/disable features (true/false)
FEATURE_FLAG_PEGA_INTEGRATION=true
FEATURE_FLAG_ADVANCED_ANALYTICS=true
FEATURE_FLAG_REAL_TIME_UPDATES=true

# =============================================================================
# DEVELOPMENT TOOLS
# =============================================================================
# Development-only features (true/false)
ENABLE_DEV_TOOLS=true
ENABLE_DEBUG_MODE=true
ENABLE_HOT_RELOAD=true

# =============================================================================
# PERFORMANCE MONITORING
# =============================================================================
# Performance monitoring (true/false)
ENABLE_PERFORMANCE_MONITORING=false
PERFORMANCE_MONITORING_URL=

# =============================================================================
# SECURITY CONFIGURATION
# =============================================================================
# CORS and rate limiting
CORS_ORIGIN=http://localhost:3000
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW=900000

# =============================================================================
# BACKUP CONFIGURATION
# =============================================================================
# Backup settings
BACKUP_ENABLED=false
BACKUP_SCHEDULE=0 2 * * *
BACKUP_RETENTION_DAYS=30
